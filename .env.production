# Non-secret production defaults for the in-process stream pollers.
#
# These are fallbacks, not overrides. Next.js checks process.env first, so
# values set in the CranL Environment panel (or any other runtime environment)
# take precedence over this file. Locally, .env.local also takes precedence.
#
# Fast covers Twitch and Kick. Slow covers YouTube and stays quota-safe.
STREAM_POLL_FAST_INTERVAL_SECS=60
STREAM_POLL_INTERVAL_SECS=1800
