# ---------------------------------------------------------------------------
# Komu - example environment variables
#
# Copy to `.env.local` and fill in real values:
#   cp .env.example .env.local
#
# `.env.local` is gitignored. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Session security (required) -----------------------------------------
# Signs the dashboard session cookie. Must be at least 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# --- Database (required) --------------------------------------------------
# PostgreSQL connection string. Used by Prisma at runtime and by the CLI
# (migrations, seed).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# --- Discord application --------------------------------------------------
# One Discord application provides both the bot and the OAuth login used by
# the dashboard. Create it at https://discord.com/developers/applications
#
#   DISCORD_CLIENT_ID     -> "General Information" -> Application ID
#   DISCORD_CLIENT_SECRET -> "General Information" -> Client Secret
#   DISCORD_BOT_TOKEN     -> "Bot" -> Reset Token
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_BOT_TOKEN=""

# Public URL of this app. Used to build the OAuth redirect URI.
# No trailing slash.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Stream alert polling (Phase 5) ---------------------------------------
# Shared secret for GET /api/internal/poll-streams. Anyone holding this value
# can make the bot send messages, so keep it out of version control.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STREAM_POLL_SECRET=""

# Set to a number of seconds to let the app poll providers on a timer. Leave
# empty when an external cron calls the endpoint instead, so passes never
# overlap. Self-hosted only: platforms that freeze idle instances will not
# honour the timer.
#   STREAM_POLL_INTERVAL_SECS=60
STREAM_POLL_INTERVAL_SECS=""

# --- Twitch (optional, needed for Phase 4+) ------------------------------
# Create an application at https://dev.twitch.tv/console/apps
# TWITCH_CLIENT_ID     -> Client ID
# TWITCH_CLIENT_SECRET -> Client Secret
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""

# --- YouTube / Google (optional, Phase 4+) --------------------------------
# Create OAuth credentials in the Google Cloud Console (YouTube Data API v3).
# Enable the "YouTube Data API v3" and "YouTube Live Streaming API".
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""

# --- Kick (optional, Phase 4+) --------------------------------------------
# Create an application at https://kick.com/settings/developer
KICK_CLIENT_ID=""
KICK_CLIENT_SECRET=""