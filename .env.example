# ---------------------------------------------------------------------------
# Komu - example environment variables
#
# Copy to `.env.local` and fill in real values:
#   cp .env.example .env.local
#
# `.env.local` is gitignored. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Session security (required) -----------------------------------------
# Signs the dashboard session cookie, and derives the key that encrypts
# Discord access tokens at rest. Must be at least 32 characters. Rotating it
# signs everyone out and makes existing stored tokens unreadable, so affected
# users sign in again.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# --- Database (required) --------------------------------------------------
# PostgreSQL connection string. Used by Prisma at runtime and by the CLI
# (migrations, seed).
#
# Keep both timeouts when the database is serverless (Neon, Supabase). Those
# providers suspend idle compute, and a cold start can outlast Prisma's
# defaults. Without them the first query after a quiet period fails with
# "Can't reach database server" or a connection-pool timeout even though the
# database is healthy. `connect_timeout` covers the network connect and
# `pool_timeout` lets Prisma wait for that connection instead of giving up
# after its 10-second default.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public&connect_timeout=15&pool_timeout=30"

# --- Discord application --------------------------------------------------
# One Discord application provides both the bot and the OAuth login used by
# the dashboard. Create it at https://discord.com/developers/applications
#
#   DISCORD_CLIENT_ID     -> "General Information" -> Application ID
#   DISCORD_CLIENT_SECRET -> "General Information" -> Client Secret
#   DISCORD_BOT_TOKEN     -> "Bot" -> Reset Token
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_BOT_TOKEN=""

# Public URL of this app. Used to build the OAuth redirect URI.
# No trailing slash.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Stream alert polling (Phase 5) ---------------------------------------
# Shared secret for POST /api/internal/poll-streams. Anyone holding this value
# can make the bot send messages, so keep it out of version control. Must be
# at least 32 characters; the endpoint refuses to run with anything shorter.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STREAM_POLL_SECRET=""

# In-process timers. Leave both empty when an external cron calls the
# endpoint instead, so passes never overlap. Self-hosted only: platforms that
# freeze idle instances will not honour the timers.
#
# STREAM_POLL_INTERVAL_SECS covers YouTube. Use 1800 or higher on the default
# YouTube quota. If the fast interval is unset, this interval covers every
# provider (the original single-timer behaviour).
#   STREAM_POLL_INTERVAL_SECS=1800
#
# STREAM_POLL_FAST_INTERVAL_SECS covers Twitch and Kick. 60 is comfortable.
# When this is set, the slow interval is used only for YouTube. Set both to
# get short waits for Twitch/Kick and a quota-safe wait for YouTube.
#   STREAM_POLL_FAST_INTERVAL_SECS=60
STREAM_POLL_INTERVAL_SECS=""
STREAM_POLL_FAST_INTERVAL_SECS=""

# --- Twitch (optional, needed for Phase 4+) ------------------------------
# Create an application at https://dev.twitch.tv/console/apps
# TWITCH_CLIENT_ID     -> Client ID
# TWITCH_CLIENT_SECRET -> Client Secret
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""

# --- YouTube / Google (optional) -------------------------------------------
# In the Google Cloud Console, enable "YouTube Data API v3", then create an
# API key under APIs & Services -> Credentials. This is the AIza... key, not
# an OAuth client id: the lookups read public data, so no account grant is
# involved. Restrict the key to the YouTube Data API.
#
# Quota warning: checking whether a channel is live costs 101 units per poll
# (search.list alone is 100), against a default daily allowance of 10,000.
# Set STREAM_POLL_INTERVAL_SECS to 1800 or higher on the default quota; 900 is
# the minimum for polling alone and leaves no room for dashboard checks.
YOUTUBE_API_KEY=""

# --- Kick (optional) ------------------------------------------------------
# Create an application at https://kick.com/settings/developer with the
# read-only channel:read and livestream:read scopes. The scopes live on the
# app; the client-credentials grant does not request them.
KICK_CLIENT_ID=""
KICK_CLIENT_SECRET=""